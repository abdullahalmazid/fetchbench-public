{
  "manifest_version": 3,
  "name": "Fetchbench",
  "version": "1.2.0",
  "description": "Sends browser downloads and web videos to the Fetchbench download manager.",
  "permissions": ["downloads", "cookies", "storage", "contextMenus", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Fetchbench" },
  "icons": { "128": "icon128.png" }
}
